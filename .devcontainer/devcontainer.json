{
  "name": ".NET Photo Gallery - Intermediate Copilot",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "hostRequirements": {
    "cpus": 4
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Photo Gallery",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "dotnet restore",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}